{
  "name": "@zifyai/dsh-client-ui-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client/index.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@zifyai/dsh-api-workspace-mutations": "workspace:*",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "6.0.3",
    "@codemirror/lint": "^6.8.4",
    "@zifyai/dsh-api-lsp": "workspace:*",
    "marked": "^15.0.6",
    "dompurify": "^3.2.4",
    "@types/dompurify": "^3.2.0",
    "@codemirror/autocomplete": "^6.18.4",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3"
  }
}
