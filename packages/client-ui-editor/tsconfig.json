{
  "compilerOptions": {
    "composite": true, "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "strict": true,
    "declaration": true, "emitDeclarationOnly": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "rootDir": "src", "outDir": "lib"
  },
  "include": ["src"]
}
